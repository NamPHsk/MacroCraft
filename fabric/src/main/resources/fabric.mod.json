{
  "schemaVersion": 1,
  "id": "macrocraft",
  "version": "${version}",

  "name": "MacroCraft",
  "description": "MacroCraft records, saves, and replays client input macros.",
  "authors": ["Boxadactle"],
  "contact": {},

  "license": "MIT",
  "icon": "icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.boxadactle.macrocraft.fabric.MacroCraftFabric"
    ],
    "modmenu": [
      "dev.boxadactle.macrocraft.fabric.MacroCraftModmenu"
    ]
  },
  "mixins": [
    "macrocraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.154.2+26.2",
    "minecraft": "26.2",
    "java": ">=25",
    "boxlib": ">=22.0.1"
  }
}
